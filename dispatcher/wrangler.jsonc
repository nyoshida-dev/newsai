{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsai-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // テストアカウント吉田 — the account this repo's wrangler login can deploy to.
  // Change if the dispatcher should live on a different account.
  "account_id": "551a70c14b764d04a5bf9b19f692c571",
  "triggers": {
    // Wake hourly; the Worker reads config.toml [schedule] and dispatches only
    // on the configured hour. The delivery time lives in config.toml (editable
    // from the dashboard) — do not encode it here. Cloudflare Cron Triggers
    // fire on time, unlike GitHub's fork schedule.
    "crons": ["0 * * * *"]
  },
  "vars": {
    "REPO_OWNER": "nyoshida-dev",
    "REPO_NAME": "newsai",
    "WORKFLOW_FILE": "weekly-news.yml",
    "REF": "main",
    "CONFIG_PATH": "config.toml"
  }
  // Secret (set via `wrangler secret put`): GITHUB_TOKEN, and optionally TRIGGER_KEY.
}
